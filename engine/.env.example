# garlic engine. Copy to .env and fill in. LIVE stays false until the money paths are proven.
BRAND=garlic
SITE_URL=https://www.usegarlic.xyz
META_BASE_URL=https://garlic-pad.vercel.app
LIVE=false
PORT=3214
HOST=127.0.0.1
DATA_DIR=./data
# The master wallet: pays every launch and network fee; its secret derives every coin's creator key.
MASTER_PRIVATE_KEY=
ADMIN_SECRET=
# GARLIC_RPC_URL wins over SOLANA_RPC_URL (some machines set that globally for other projects)
GARLIC_RPC_URL=
PRIVATE_SEND=true
JITO_TIP_LAMPORTS=200000
MAX_LAUNCHES_PER_HOUR=60
WALLET_COOLDOWN_MIN=60
LAUNCHER_MIN_SOL=0.01
MASTER_FLOOR_SOL=0.05
CRANK_MS=180000
MIN_BUYBACK_SOL=0.003
MAX_BUYBACK_SOL=5
PRIVATE_BUYBACK_MIN_SOL=0.05
PUBLIC_SLIPPAGE_PCT=1.5
SLIPPAGE_PCT=5
# optional: pin coin pictures + metadata to IPFS instead of hosting them on the engine
PINATA_JWT=
# optional: the platform's own coin and X account, shown on the site
COIN_MINT=
X_URL=
